__pycache__/
*.pyc
.claude/

# Gerado por publicar.py a cada atualização (~8 mil arquivos). O site no ar
# vem do artefato da Action, não do repositório — versionar isso faria o
# repositório crescer alguns MB por dia sem necessidade.
web/
web.zip

# Gerado por embutir.py: o app com o instantâneo dentro, para prévia por
# link. Pesa alguns MB e muda a cada coleta — o fonte é o prototipo.html.
previa.html

# As listas de contemplados, refeitas pela rodada leve dos sorteios (a cada
# 20 minutos na janela do sorteio). Saida gerada, como a base.
dados/sorteados.json

# A base coletada. Deixou de ser versionada: cada coleta acrescentava ~5 MB
# pouco compressível, e o site sai do artefato da Action, não do repositório.
# Para ter uma base local: python coletor.py --dias 60
dados/eventos.json

# A chave da API do GoatCounter. Nunca versionada: com ela dá para ler o
# painel inteiro. Crie em Settings -> API tokens e grave aqui.
.goatcounter-token

# Gerado por painel.py a partir da medição e da coleta.
painel.html

# Export do GoatCounter, baixado a mao para alimentar o painel.
GoatCounter/

# capturas de tela do app (regeraveis com divulgacao/capturar.py)
divulgacao/telas/_*.png
divulgacao/__pycache__/
